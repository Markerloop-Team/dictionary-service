# dictionary-service — example configuration. Placeholders only.

PORT=8084
HOST=0.0.0.0
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
LOG_LEVEL=info

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<local-db-password>
DB_NAME=dictionary
DB_SSLMODE=disable

# Redis cache
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=2
CACHE_TTL=1h
